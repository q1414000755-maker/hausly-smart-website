  "_placeholder": {
    "active": true,
    "render_banner": false,
    "summary": "本文件全部为占位数据，用于把页面结构与交互跑通。替换真实数据时只改本文件的值，代码不需要改。",
    "why_no_banner": "与 smart-switches.json 同一口径：包子 2026-09-17 指示「标记写在代码里，页面渲染看不到」，所以 render_banner = false。对外演示或上线前改成 true 即可渲染出原型横幅。",
    "replace": [
      {
        "what": "产品图",
        "where": "model_groups[*].variants[*].image.src",
        "with": "真实产品摄影。当前全部指向 assets/images/placeholders/product-*.svg。"
      },
      {
        "what": "参考价",
        "where": "model_groups[*].variants[*].price.amount",
        "with": "真实参考价。换价时把 price.status 从 placeholder 改成 confirmed，并更新 checked_on。"
      },
      {
        "what": "型号与 SKU",
        "where": "model_groups[*].model_id 与 variants[*].sku",
        "with": "真实型号编码与 SKU。当前 GSL-* 这类是行业通用写法，不是真实编码。"
      }
    ]
  },
